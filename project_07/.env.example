# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
# If empty, RecipeMaster uses the built-in resilient database storage engine
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/recipemaster?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=recipemaster_jwt_super_secure_secret_key_2026

# External Recipe API (TheMealDB public free API)
MEALDB_API_URL=https://www.themealdb.com/api/json/v1/1

# Google Gemini API Key for Search-Grounded Culinary Guidance
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
